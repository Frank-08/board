# Configuration files with sensitive data
config/database.php.local
config/config.php.local

# Legacy local uploads directory (documents are SharePoint links now)
uploads/

# PHP specific
*.log
*.cache

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Vm File
*.ova
*.vmdk

# keys
apikey


# Composer dependencies (installed on the server, not committed)
/vendor/

# Backups - database dumps and file copies must never be committed
# (they hold member data / credentials). Migrations in database/ are not
# affected: they're tracked files and none match these patterns.
backups/
backup/
/*.sql
*backup*.sql
*.sql.gz
*.sql.zip
*.dump
*.orig
