# Apache Configuration for Governance Board Management System

# Enable rewrite engine
RewriteEngine On

# Set base directory
RewriteBase /board/

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files (Apache 2.4 syntax - "Order/Deny" needs
# mod_access_compat)
<FilesMatch "^(\.htaccess|\.env|config\.php|database\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|sql|sql\.gz|sql\.zip|dump|bak|orig|bas|sh|log|kts|gradle)$">
    Require all denied
</FilesMatch>

# Directories that are only ever include()d or run from the command line -
# never served. PHP's require_once still reads them from disk. Libraries in
# libs/ (phpqrcode, TCPDF) are included by the pages that need them.
RewriteRule ^(config|includes|database|scripts|libs|uploads|vendor|android|word\ macro|\.git|\.github)(/|$) - [F,L]

# Allow access to API files
#<DirectoryMatch "^.*/api/">
#    AllowOverride None
#    Require all granted
#</DirectoryMatch>

# PHP settings
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /var/log/php_errors.log
    php_value post_max_size 30M
    php_value max_execution_time 300
</IfModule>

# Word report template (assets/templates/) for agenda item submissions
<IfModule mod_mime.c>
    AddType application/vnd.openxmlformats-officedocument.wordprocessingml.template .dotx
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

